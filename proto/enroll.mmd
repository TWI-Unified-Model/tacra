%% Minting new proof-of-possession credentials
sequenceDiagram
    participant W as Workload
    participant CAA_C as CAAPI<br/>Client
    participant CAS_C as CAS<br/>Client
    participant CAS_S as CAS<br/>Server
    participant V as Verifier
    participant CA as Certificate Authority

    autonumber

    note over W, CAA_C: CAAPI Local Call
    activate W
    note over CAA_C, CAS_C: CAAPI gRPC Call
    activate CAA_C
    W->>CAS_C: Enroll Credential<br/>(Target, Credential Type, Evidence incl. CSR)
    deactivate CAA_C
    deactivate W
    note over CAS_C, CAS_S: Invoke CAS Server<br/>over CAS Protocol
    activate CAS_C
    CAS_C->>CAS_S: Enroll Credential<br/>(Target, Credential Type,<br/>Evidence incl. CSR)
    deactivate CAS_C
    note over CAS_S, V: Verifier Protocol
    activate CAS_S
    CAS_S->>CAS_S: Verify Evidence-to-CSR binding
    CAS_S->>V: Request Attestation<br/>(Evidence incl. CSR)
    deactivate CAS_S
    activate V
    V->>V: Check Evidence
    V->>V: Include CSR in<br/>Attestation Results
    V-->>CAS_S: Attestation Results
    deactivate V
    note over CAS_S, CA: Certificate Authority Invocation
    activate CAS_S
    CAS_S->>CA: Enroll Credential<br/>(Attestation Results incl. CSR)
    deactivate CAS_S
    activate CA
    CA->>CA: Validate<br/>Attestation Results
    CA->>CA: Mint New Credential<br/>from CSR, Attestation Results
    CA-->>CAS_S: Newly Minted (Enrolled) Credential
    deactivate CA
    CAS_S-->>CAS_C: Enrolled Credential
    CAS_C-->>W: Enrolled Credential
