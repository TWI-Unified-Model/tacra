%% Acquire-Credential (CAI)
%% The Attester's single CAI call. CAI drives CAAPI and the Platform Plug-In.
%% Enrollment vs Retrieval is chosen by the CAS and is opaque to the Attester.
sequenceDiagram
    participant A as Attester
    participant CAI as CAI Implementation
    participant PL as Platform Plug-In
    participant CAS as CAS via<br/>CAAPI

    A->>CAI: Acquire-Credential<br/>(Target, Credential Type, Credential Hint)
    note over CAI, CAS: Initiate-Credential-Acquisition Flow
    CAI->>CAS: Initiate-Credential-Acquisition<br/>(Target, Credential Type)
    alt Invalid Target, Unsupported Credential Type,<br/>or other error
        CAS-->>CAI: Error
        CAI-->>A: Error
    else Success
        CAS-->>CAI: Mode, Freshness Kind,<br/>Freshness Handle (present-* only),<br/>Signing Algorithm (enroll) or<br/>Encryption Algorithm (retrieve)
        alt Mode is Enroll
            note over CAI, CAS: Enroll-Credential Flow
            CAI->>PL: GenerateCSK(Signing Algorithm)
            PL-->>CAI: CSKpub, CSKpri
            CAI->>CAI: Generate CSR from CSKpri
            CAI->>PL: Generate Evidence<br/>(Target, CSR, Freshness Kind,<br/>Freshness Handle if present-*)
            PL-->>CAI: Evidence with TACRA Binding<br/>(freshness, Target, CSR)
            CAI->>CAS: Enroll-Credential<br/>(Target, Credential Type, Credential Hint,<br/>Evidence, CSR, Signing Algorithm)
            CAS-->>CAI: Plaintext enrolled credential
            CAI-->>A: Credential and CSKpri
        else Mode is Retrieve
            note over CAI, CAS: Retrieve-Credential Flow
            CAI->>PL: GenerateCEK(Encryption Algorithm)
            PL-->>CAI: CEKpub, CEKpri
            CAI->>PL: Generate Evidence<br/>(Target, CEKpub, Freshness Kind,<br/>Freshness Handle if present-*)
            PL-->>CAI: Evidence with TACRA Binding<br/>(freshness, Target, CEKpub)
            CAI->>CAS: Retrieve-Credential<br/>(Target, Credential Type, Credential Hint,<br/>Evidence, Encryption Algorithm)
            CAS-->>CAI: Credential wrapped to CEKpub
            CAI->>CAI: Unwrap with CEKpri
            CAI-->>A: Credential
        end
    end
