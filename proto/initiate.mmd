%% Initiating Credential Acquisition
%% by requesting a freshness handle from the Verifier
%% The "Workload" here may be the Attester's Credential Acquisition Interface
sequenceDiagram
    participant W as Workload
    participant CAA_C as CAAPI<br/>Client
    participant CAS_C as CAS<br/>Client
    participant CAS_S as CAS<br/>Server
    participant V as Verifier

    autonumber

    note over W, CAA_C: CAAPI Local Call
    activate W
    note over CAA_C, CAS_C: CAAPI External Call
    activate CAA_C
    W->>CAS_C: Initiate Credential Acquisition<br/>(Target, Credential Type)
    deactivate CAA_C
    deactivate W
    activate CAS_C
    CAS_C->>CAS_C: Validate Target,<br/>Determine CAS Server<br>and Credential Type<br/>based on Target
    alt Requested Credential Type Not Supported<br/>or Target is Invalid
        CAS_C-->>W: Return error: "Unsupported Credential Types" or "Invalid Target"
    else Requested Credential Type Is Supported<br/>and Target is Valid
        note over CAS_C, CAS_S: Invoke CAS Server<br/>over CAS Protocol
        CAS_C->>CAS_S: Request Freshness<br/>(Target)
        deactivate CAS_C
        activate CAS_S
        CAS_S->>CAS_S: Determine Credential<br/>Acquisition Mode<br/>based on Target
        note over CAS_S, V: Invoke Verifier
        CAS_S->>V: Request Freshness Handle
        deactivate CAS_S
        activate V
        V->>V: Compute Freshness Handle
        V-->>CAS_S: Return Freshness Handle
        deactivate V
        CAS_S-->>CAS_C: Return Freshness Kind,<br/>Freshness Handle, and<br/>Credential Acquisition Mode
        CAS_C-->>W: Return Freshness Kind, Freshness Handle,<br/>and Credential Acquisition Mode
    end
