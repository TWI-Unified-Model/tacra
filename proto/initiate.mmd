%% Initiate-Credential-Acquisition (CAAPI)
%% First CAAPI call of Acquire-Credential: obtain Mode, Freshness Kind,
%% and a Freshness Handle when the kind is present-nonce or present-epoch.
%% The CAS Server is a conduit; it MUST NOT generate present-* Handles.
sequenceDiagram
    participant CAI as CAI
    participant CAS_C as CAS<br/>Client
    participant CAS_S as CAS<br/>Server
    participant V as Verifier

    autonumber

    note over CAI, CAS_C: CAAPI
    CAI->>CAS_C: Initiate-Credential-Acquisition<br/>(Target, Credential Type)
    CAS_C->>CAS_C: Validate Target and<br/>Credential Type
    alt Invalid Target or Unsupported Credential Type
        CAS_C-->>CAI: Error: Invalid Target or<br/>Unsupported Credential Type
    else Target and Credential Type are supported
        note over CAS_C, CAS_S: CAS Protocol
        CAS_C->>CAS_S: Initiate-Credential-Acquisition<br/>(Target, Credential Type)
        CAS_S->>CAS_S: Select Mode and Freshness Kind<br/>from policy for Target and Type
        alt Freshness Kind is present-nonce or present-epoch
            note over CAS_S, V: Handle is Verifier-originated<br/>or RATS Relying Party-originated
            CAS_S->>V: Request Freshness Handle
            V-->>CAS_S: Freshness Handle
            CAS_S-->>CAS_C: Mode, Freshness Kind, Freshness Handle,<br/>Signing Algorithm (enroll) or<br/>Encryption Algorithm (retrieve)
        else Freshness Kind is absent-*
            CAS_S-->>CAS_C: Mode, Freshness Kind,<br/>Signing Algorithm (enroll) or<br/>Encryption Algorithm (retrieve)
        end
        CAS_C-->>CAI: Mode, Freshness Kind,<br/>Freshness Handle if present-*,<br/>Signing or Encryption Algorithm
    end
